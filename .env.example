# VITA environment variables.
# Copy this file to .env and fill in real values. Never commit .env.
# EXPO_PUBLIC_ variables are bundled into the app and visible to users —
# only publishable keys belong here. Secrets stay server-side (Supabase edge functions).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Food providers (Sprint 2) ────────────────────────────────────────────
# USDA FoodData Central. Free key from https://fdc.nal.usda.gov/api-key-signup
# This is a rate-limiting identifier (1,000 req/hour), not a true secret, which
# is why EXPO_PUBLIC_ is acceptable for development. USDA does deactivate keys
# found published publicly, so a public release should proxy these calls —
# see docs/09-Technical-Documentation.md. Search falls back to Open Food Facts
# alone when this is unset.
EXPO_PUBLIC_USDA_API_KEY=

# Open Food Facts requires a contact email in the User-Agent so they can reach
# an abusive client. No account or key. Without this the provider reports
# itself unconfigured rather than sending an anonymous or fake identifier.
EXPO_PUBLIC_OFF_CONTACT=
